{
  "name": "@urbanshield/server",
  "version": "1.0.0",
  "description": "UrbanShield AI Emergency Response Core Server",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "npm --prefix ../shared install || true",
    "build": "npm --prefix ../shared install && npm --prefix ../shared run build && tsc",
    "start": "node dist/server.js",
    "start:tsx": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts"
  },
  "dependencies": {
    "@urbanshield/shared": "file:../shared",
    "@google/genai": "^2.27.0",
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.5",
    "zod": "^3.23.8",
    "ws": "^8.18.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  }
}
